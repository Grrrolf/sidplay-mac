prefix=/tmp/engine_fp_install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libsidplayfp
Description: C64 cycle exact stereo sidplayer library.
Version: 3.1.1
Libs.private: -L/tmp/engine_fp_install/lib -lresidfp  -L/opt/homebrew/Cellar/libusb/1.0.30/lib -lusb-1.0 -lpthread
Libs: -L${libdir} -lsidplayfp
Cflags: -I${includedir}
